{
  "files": {
    "includes": [
      "**",
      "!dist",
      "!node_modules",
      "!.claude",
      "!storybook-static"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": ["src/examples/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveTabindex": "off",
            "useSemanticElements": "off",
            "noStaticElementInteractions": "off",
            "noSvgWithoutTitle": "off",
            "useKeyWithClickEvents": "off",
            "noNoninteractiveElementToInteractiveRole": "off"
          }
        }
      }
    }
  ]
}
